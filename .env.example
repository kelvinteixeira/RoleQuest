# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Where data lives: "mock" (local, in this browser) or "supabase".
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase project → "Connect" button (or Project Settings → API / Data API).
# Only the PUBLIC values go here: the project URL and the anon / publishable key.
# Never put the service_role / secret key in this app: it bypasses every access rule.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
