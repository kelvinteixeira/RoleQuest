# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Where data lives: "mock" (local, in this browser) or "supabase".
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase project → "Connect" button (or Project Settings → API / Data API).
# The project URL and the anon / publishable key are public (Row Level Security guards the data).
# The service_role key bypasses every access rule: server only (no NEXT_PUBLIC_ prefix), used
# by the billing webhook and the reminders job — never anywhere the browser can read it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Chronicles Studio (server only — never prefix these with NEXT_PUBLIC_).
# Script writer (Claude): https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Panel images (Gemini): https://aistudio.google.com → Get API key.
GEMINI_API_KEY=
# Optional: another Gemini image model.
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Narration (Chronicles "Gravar narração"), same key. Optional overrides:
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Charon

# Voice chat (optional). Calls go straight between browsers; a free STUN server
# finds a route through most routers. For players behind strict networks
# (some offices, mobile carriers), add a TURN server to relay the audio.
# These are visible in the browser: use credentials limited to TURN.
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
# Better: short-lived TURN credentials made on the server for each person (server only).
# A coturn server with use-auth-secret ("TURN REST API"):
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=
# …or Cloudflare TURN (dash.cloudflare.com → Calls → TURN):
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Large tables (8+ people): a LiveKit media server instead of direct calls.
# NEXT_PUBLIC_VOICE_PROVIDER=livekit
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Launch ---------------------------------------------------------------

# Public address of the site (links in e-mails, Stripe return pages, calendar links).
# NEXT_PUBLIC_APP_URL=https://rolequest.app

# Who runs this installation (terms and privacy pages). Unset values show in [brackets].
# NEXT_PUBLIC_LEGAL_ENTITY=
# NEXT_PUBLIC_LEGAL_DOCUMENT=
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_LEGAL_CITY=

# Server jobs (billing webhook, reminders). Supabase → Project Settings → API → service_role.
# SUPABASE_SERVICE_ROLE_KEY=

# Payments (Stripe). Create the products/prices in Stripe and paste the price ids.
# Then switch limits on in the database: update billing_config set enforce = true;
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MESTRE=price_...
# STRIPE_PRICE_MESA=price_...
# STRIPE_PRICE_CREDITS_100=price_...
# STRIPE_PRICE_CREDITS_300=price_...

# Session reminders by e-mail (Resend) — hourly job in vercel.json, protected by CRON_SECRET.
# RESEND_API_KEY=
# REMINDER_FROM=Role Quest <lembretes@seu-dominio.com>
# CRON_SECRET=

# Error alerts: a Discord or Slack incoming webhook (errors also go to the server log).
# ERROR_WEBHOOK_URL=
